---
import BaseHead from "./BaseHead.astro";
import Footer from "./Footer.astro";
import FormattedDate from "./FormattedDate.astro";
import Header from "./Header.astro";

interface Props {
  title: string;
  description: string;
  date?: Date;
  useRss?: boolean;
  dir?: "auto" | "rtl" | "ltr";
  lang?: string;
}
const {
  title,
  description,
  date,
  useRss = false,
  dir = "auto",
  lang = "en",
} = Astro.props;
---

<!doctype html>
<html lang={lang}>
  <head>
    <BaseHead title={title} description={description} useRss={useRss} />
    <slot name="head" />
  </head>
  <body>
    <Header />
    <main dir={dir}>
      <h1>{title}</h1>
      {
        date && (
          <h3 style="text-align: center;">
            <FormattedDate date={date} />
          </h3>
        )
      }
      <slot name="pagenav" />
      <article>
        <slot />
      </article>
      <slot name="pagenav" />
    </main>
    <Footer />
  </body>
</html>
